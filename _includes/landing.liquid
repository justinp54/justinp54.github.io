{% assign recent_reviews = site.reviews | sort: 'date' | reverse %}
{% assign recent_posts = site.posts | sort: 'date' | reverse %}
{% assign recent_news = site.news | sort: 'date' | reverse %}
{% assign featured_projects = site.projects | sort: 'importance' %}

<section class="panel panel-hero" data-panel="hero" data-stage="structure" data-morph="0">
  <div class="panel-copy">
    <p class="eyebrow">Computational biology &middot; Seoul National University</p>
    <h1 class="panel-title display-xl">
      <span class="title-line">From protein structure</span>
      <span class="title-line">to how molecules bind,</span>
      <span class="title-line">learned by machines.</span>
    </h1>
    <p class="panel-lead">
      I am an undergraduate researcher studying how structure-based machine learning can explain and predict the way proteins move, bind and signal.
    </p>
  </div>
  <div class="scroll-cue" aria-hidden="true">&darr;</div>
</section>

<section class="panel panel-right" id="about" data-panel="about" data-stage="structure" data-morph="0.2">
  <div class="panel-card">
    <p class="eyebrow">About</p>
    <h2 class="display-lg">A research log, kept in the open.</h2>
    <p>
      This site is a long-term academic portfolio and a running record of how I read papers, work through equations and turn them into research ideas.
    </p>
    <p class="panel-focus">
      Current focus: protein&ndash;ligand interaction modeling, structure representations and embeddings, and generative models for molecular systems.
    </p>
    <div class="panel-links">
      <a href="{{ '/cv/' | relative_url }}">CV &rarr;</a>
    </div>
  </div>
</section>

<section class="panel" id="research" data-panel="research" data-stage="binding" data-morph="0.45">
  <div class="panel-card">
    <p class="eyebrow">Research &amp; Projects</p>
    <h2 class="display-lg">Structure, dynamics and the models that read them.</h2>
    <p>
      At the Computational Biology Laboratory I study structural determinants of GPCR agonism and antagonism, contribute to protein&ndash;ligand
      complex modeling for CASP17, and build tools that make chemical engineering theory visible.
    </p>
    {% if featured_projects.size > 0 %}
      <ul class="panel-list">
        {% for project in featured_projects limit: 3 %}
          <li>
            <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
            <span>{{ project.description }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    <div class="panel-links">
      <a href="{{ '/projects/' | relative_url }}">All projects &rarr;</a>
    </div>
  </div>
</section>

<section class="panel panel-right" id="reviews" data-panel="reviews" data-stage="docking" data-morph="0.7">
  <div class="panel-card">
    <p class="eyebrow">Paper Reviews</p>
    <h2 class="display-lg">Reading notes, written to be re-read.</h2>
    <p>
      Structured notes on machine learning and bioinformatics papers, from the problem setting through the equations to what the results actually
      show.
    </p>
    {% if recent_reviews.size > 0 %}
      <ul class="panel-list">
        {% for review in recent_reviews limit: 3 %}
          <li>
            <a href="{{ review.url | relative_url }}">{{ review.title }}</a>
            <span>{{ review.date | date: '%b %d, %Y' }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    <div class="panel-links">
      <a href="{{ '/reviews/' | relative_url }}">All reviews &rarr;</a>
    </div>
  </div>
</section>

<section class="panel" id="journal" data-panel="journal" data-stage="dispersal" data-morph="0.85">
  <div class="panel-card">
    <p class="eyebrow">Journal</p>
    <h2 class="display-lg">Shorter entries, while the work is still messy.</h2>
    <p>Informal notes on experiments, study detours and the parts of a problem that have not settled into a review yet.</p>
    {% if recent_posts.size > 0 %}
      <ul class="panel-list">
        {% for post in recent_posts limit: 3 %}
          <li>
            <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
            <span>{{ post.date | date: '%b %d, %Y' }}</span>
          </li>
        {% endfor %}
      </ul>
      <div class="panel-links">
        <a href="{{ '/blog/' | relative_url }}">All entries &rarr;</a>
      </div>
    {% else %}
      <p class="panel-empty">First entry coming soon.</p>
    {% endif %}
  </div>
</section>

<section class="panel panel-final" id="news" data-panel="news" data-stage="calm" data-morph="1">
  <div class="panel-card">
    <p class="eyebrow">News</p>
    {% if recent_news.size > 0 %}
      <ul class="panel-news">
        {% for item in recent_news limit: 4 %}
          <li>
            <span class="news-date">{{ item.date | date: '%b %Y' }}</span>
            <span class="news-body">{{ item.content | strip_html | strip | truncate: 140 }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    <div class="panel-links panel-contact">
      <a href="mailto:{{ site.data.socials.email }}">Email</a>
      <a href="{{ '/cv/' | relative_url }}">CV</a>
      <a href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="{{ '/news/' | relative_url }}">All news &rarr;</a>
    </div>
  </div>
</section>
